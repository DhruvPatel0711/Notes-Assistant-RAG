# Environment variables for Laws of Power RAG Assistant
# Copy this file to .env and fill in your values.

# Google AI API key (required for LLM features)
GOOGLE_API_KEY=your_api_key_here

# Embedding model (HuggingFace model ID)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Gemini model fallback chain (comma-separated, tried in order)
# When one model hits a rate limit, the next one is used automatically.
LLM_MODELS_STR=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# ChromaDB settings
CHROMA_DIR=chroma_db
COLLECTION_NAME=laws_of_power

# Retrieval settings
TOP_K=5

# LLM temperature (0 = deterministic for evaluation, higher for interactive)
TEMPERATURE=0
TEMPERATURE_INTERACTIVE=0.3

# Data directories (relative to project root)
DATA_DIR=data
OUTPUT_DIR=output
